# Dogfood 2026 Environment Configuration
# System Port Configuration
PORT=5000
FRONTEND_PORT=3000
JUDGING_SERVICE_PORT=8000
MONGO_PORT=27017

# Node.js Core Backend
NODE_ENV=production
MONGO_URI=mongodb://mongodb:27017/dogfood
JUDGING_SERVICE_URL=http://judging-service:8000
JWT_SECRET=raptors-offline-cryptographic-master-key-2026
JWT_EXPIRES_IN=1h
REFRESH_SECRET=raptors-refresh-token-secret-salt-2026
REFRESH_EXPIRES_IN=7d

# Python FastAPI Microservice
FASTAPI_ENV=production
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
