# ==============================================================================
# Dogfood 2026 — Self-Hosted Air-Gapped Hackathon Platform
# Unified Environment Configuration Template
# ==============================================================================
# Copy this template to `.env` in the project root:
#   cp .env.example .env
#
# NOTE: In Docker Compose, services communicate via the internal network bridge
# (`dogfood-net`). If running individual services locally outside Docker, use
# the `localhost` equivalents noted in comments below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Ports & Host Binding Configuration
# ------------------------------------------------------------------------------
# Core Node.js / Express REST API port
PORT=5000

# React SPA frontend (Vite dev server or Nginx container host port)
FRONTEND_PORT=3000

# Python FastAPI judging & analytics microservice port
JUDGING_SERVICE_PORT=8000

# MongoDB database host port
MONGO_PORT=27017

# ------------------------------------------------------------------------------
# 2. Database Connection URI & Configuration (MongoDB 7.0)
# ------------------------------------------------------------------------------
# Containerized Docker network connection URI
MONGO_URI=mongodb://mongodb:27017/dogfood

# Standalone Local Development connection URI (uncomment if running outside Docker):
# MONGO_URI=mongodb://localhost:27017/dogfood

# Initial database name populated during initialization
MONGO_INITDB_DATABASE=dogfood

# Optional MongoDB root credentials (uncomment if enabling authentication)
# MONGO_INITDB_ROOT_USERNAME=dogfood_admin
# MONGO_INITDB_ROOT_PASSWORD=change_this_secure_password_in_production

# ------------------------------------------------------------------------------
# 3. Cryptographic & JWT Authentication Secrets
# ------------------------------------------------------------------------------
# Cryptographic secret used for HMAC SHA-256 signing of short-lived access tokens.
# IN PRODUCTION: Generate a high-entropy 256-bit key (e.g. `openssl rand -hex 32`)
JWT_SECRET=raptors-offline-cryptographic-master-key-2026

# Access token time-to-live (e.g. '15m', '1h', '24h')
JWT_EXPIRES_IN=1h

# Cryptographic salt secret used to sign long-lived refresh tokens stored in HttpOnly cookies
REFRESH_SECRET=raptors-refresh-token-secret-salt-2026

# Refresh token time-to-live (e.g. '7d', '14d', '30d')
REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Internal Microservice URLs & Service Discovery
# ------------------------------------------------------------------------------
# Microservice endpoint for statistical scoring, normalization & Bradley-Terry ranking.
# Internal Docker network URL:
JUDGING_SERVICE_URL=http://judging-service:8000

# Standalone Local Development URL (uncomment if running outside Docker):
# JUDGING_SERVICE_URL=http://localhost:8000

# Microservice health check path
JUDGING_SERVICE_HEALTH_PATH=/api/v1/health

# ------------------------------------------------------------------------------
# 5. Core Backend Service Configuration (Node.js 20 / Express)
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=production

# Allowed CORS client origin and cookie domain validation
CLIENT_URL=http://localhost:3000

# Upload storage directory and file limits (default: 5MB in bytes)
UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 6. Judging Analytics Microservice Configuration (Python 3.11 / FastAPI)
# ------------------------------------------------------------------------------
# FastAPI runtime environment ('development' | 'production')
FASTAPI_ENV=production
ENVIRONMENT=production

# Network host binding within the container (0.0.0.0 binds to all interfaces)
HOST=0.0.0.0

# Prevent Python from buffering stdout and stderr to ensure instant container log output
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 7. Frontend Client Configuration (React 18 / Vite)
# ------------------------------------------------------------------------------
# Optional client-side API URL override (defaults to dev proxy /api/v1 in Vite)
VITE_API_URL=http://localhost:5000/api/v1
