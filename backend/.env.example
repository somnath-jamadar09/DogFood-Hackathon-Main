# ==============================================================================
# Dogfood 2026 — Core Backend Environment Configuration
# ==============================================================================

# Server & Networking
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (MongoDB)
# Local: mongodb://localhost:27017/dogfood | Docker: mongodb://mongodb:27017/dogfood
MONGO_URI=mongodb://localhost:27017/dogfood

# Internal Microservice URLs
# Local: http://localhost:8000 | Docker: http://judging-service:8000
JUDGING_SERVICE_URL=http://localhost:8000

# Authentication & Cryptographic JWT Secrets
JWT_SECRET=raptors-offline-cryptographic-master-key-2026
JWT_EXPIRES_IN=1h
REFRESH_SECRET=raptors-refresh-token-secret-salt-2026
REFRESH_EXPIRES_IN=7d
